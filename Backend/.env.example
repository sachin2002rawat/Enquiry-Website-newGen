# Node.js Server Environment
PORT=5000
NODE_ENV=production
HOST=0.0.0.0

# MongoDB Database Connection String
# For Render, use a free cloud MongoDB Atlas cluster (e.g. mongodb+srv://<user>:<password>@cluster0.mongodb.net/dbname)
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/enquirysaar?retryWrites=true&w=majority

# CORS Allowed Origin(s)
# Set to your deployed Frontend URL (comma-separated if multiple, e.g. https://your-frontend.onrender.com,http://localhost:5173)
CORS_ORIGIN=https://your-frontend-service.onrender.com
FRONTEND_URL=https://enquiry-website-clients.onrender.com

# Backend Public Base URL (optional - defaults to incoming request host)
BASE_URL=https://enquiry-website-server.onrender.com

# Security & Authentication Secret
JWT_SECRET=your_production_jwt_random_secret_string_here
JWT_EXPIRES_IN=7d

# Initial Super Admin Bootstrap Credentials (Run `npm run seed:admin`)
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@quick-enquiry.com
SUPER_ADMIN_PASSWORD=SetAStrongPassword123!

# Optional Cloudinary Storage (Recommended for persistent image uploads on Render)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional SMTP Email Notifications for Enquiries
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=QuickEnquiry
SMTP_FROM_EMAIL=
SMTP_REPLY_TO=
ADMIN_NOTIFICATION_EMAIL=
COMPANY_NAME=QuickEnquiry
